{
	"useTabs": true,
	"tabWidth": 4,
	"semi": true,
	"singleQuote": true,
	"printWidth": 120,
	"arrowParens": "always",
	"bracketSpacing": true,
	"trailingComma": "es5",
	"singleAttributePerLine": false,
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrder": [
		"<TYPES>^(node:)",
		"<BUILTIN_MODULES>",
		"<TYPES>",
		"<THIRD_PARTY_MODULES>",
		"",
		"<TYPES>^@/(.*)$",
		"",
		"^@/components/(.*)$",
		"^@/(.*)$",
		"",
		"<TYPES>^[./]",
		"^[./]"
	],
	"overrides": [
		{
			"files": "package.json",
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
