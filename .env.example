# =============================================================================
# Hummingbird Community — environment variables
# Copy this file to `.env.local` and fill in real values for local development.
# `.env.local` is git-ignored.
# =============================================================================

# App
APP_ENV=development
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# Supabase (auth + database). Create a project at https://supabase.com and copy
# the values from Project Settings → API. The anon key is safe to expose to the
# browser; the service-role key is server-only and must never be shipped client-side.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Optional add-ons (same architecture as the reference project — wire up later).
# Left unset by default; the app runs without them.
# -----------------------------------------------------------------------------
# Sentry error monitoring
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=

# PostHog analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
