# =============================================================================
# Hummingbird Community — environment variables
# Copy this file to `.env.local` and fill in real values for local development.
# `.env.local` is git-ignored.
#
# Environments:
#   • Local dev + Vercel "Preview"  -> STAGING Supabase project
#   • Vercel "Production"           -> PRODUCTION Supabase project
# Set the Production values in Vercel's Production environment scope, and the
# staging values below (and in Vercel's Preview scope).
# =============================================================================

# App
APP_ENV=development
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (auth + database) — use the STAGING project's values locally.
# Dashboard → Project Settings → API. The anon/publishable key is safe to expose
# to the browser; the service-role/secret key is server-only.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DB password(s) for migrations via `npm run db:push:staging` / `db:push:prod`.
# Keep PROD_DB_PASSWORD commented out unless you're deploying schema to prod.
STAGING_DB_PASSWORD=
# PROD_DB_PASSWORD=

# -----------------------------------------------------------------------------
# GitHub OAuth — connect a user's GitHub account (HB-6).
# Register an OAuth App at https://github.com/settings/developers with the
# callback URL `${NEXT_PUBLIC_PUBLIC_BASE_URL}/api/github/callback`.
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32-byte key (base64) that encrypts stored GitHub tokens at rest. Generate with:
#   openssl rand -base64 32
GITHUB_TOKEN_ENC_KEY=

# -----------------------------------------------------------------------------
# GitHub Research Agent — investigation workflow (Phase 0+).
# -----------------------------------------------------------------------------
# Google Gemini API key for AI synthesis. Get one at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GitHub token for agent API calls (investigating any GitHub user). Can be:
#   • A fine-grained PAT with public read-only access
#   • A GitHub App installation token
#   • Omit to use the requesting user's connected OAuth token (if available)
# GITHUB_AGENT_TOKEN=

# -----------------------------------------------------------------------------
# Optional add-ons (same architecture as the reference project — wire up later).
# -----------------------------------------------------------------------------
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
